# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Compiled example binaries (each example is `package main`; `go build ./...`
# drops a binary named after its directory). Extensionless, so list them.
/examples/basic/basic
/examples/email/email
/examples/fiber/fiber
/examples/gin/gin
/examples/jwt/jwt
/examples/password/password
/examples/username/username

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# authcore managed key directory — never commit cryptographic keys
.authcore/
